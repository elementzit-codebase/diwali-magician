# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=voting_app
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Security & Sessions
JWT_SECRET=super_secret_jwt_admin_key_replace_in_production_32chars
SESSION_SECRET=super_secret_session_signing_key_replace_in_production_32chars
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Client URL (for CORS if necessary, otherwise same-origin)
CLIENT_URL=http://localhost:5000

